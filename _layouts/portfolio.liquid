<!doctype html>
<html lang="{{ page.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% unless page.home %}{{ page.title | escape }} · {% endunless %}
      Mart Laanpere
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:title" content="{{ page.title | escape }} · Mart Laanpere">
    <meta property="og:description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <link rel="icon" href="{{ '/assets/img/monogram.svg' | relative_url }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ '/assets/css/portfolio.css' | relative_url }}">
    <script src="{{ '/assets/js/portfolio.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="{{ '/' | relative_url }}" aria-label="Mart Laanpere homepage">ML<span>Mart Laanpere</span></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu <span aria-hidden="true">＋</span></button>
        <nav id="main-nav" aria-label="Main navigation">
          {% for item in site.data.navigation.en -%}
            <a
              href="{{ item.url | relative_url }}"
              {% if page.url == item.url %}
                aria-current="page"
              {% endif %}
            >
              {{- item.title -}}
            </a>
          {%- endfor %}
        </nav>
        <div class="languages" aria-label="Language">
          <span lang="en" aria-current="true">EN</span><span aria-hidden="true">/</span
          ><a lang="et" href="{{ '/et/' | relative_url }}" title="Estonian edition — in preparation">ET</a>
        </div>
      </div>
    </header>
    <main id="main" class="site-main {% if page.home %}home{% endif %}">
      {% unless page.home or page.case_study %}
        <header class="page-heading">
          <p class="eyebrow">{{ page.eyebrow | default: 'Research · Design · Impact' }}</p>
          <h1>{{ page.title }}</h1>
          {% if page.description %}
            <p class="lead">{{ page.description }}</p>
          {% endif %}
        </header>
      {% endunless %}
      {{ content }}
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-top">
          <div>
            <p class="footer-name">Mart Laanpere</p>
            <p>Professor · Researcher · EdTech Designer</p>
          </div>
          <a class="text-link" href="mailto:mart.laanpere@tlu.ee">Discuss a collaboration <span aria-hidden="true">↗</span></a>
        </div>
        <div class="affiliations" aria-label="University and project connections">
          <a href="https://www.tlu.ee/en/node/106574"
            ><img src="{{ '/assets/img/brands/tlu.svg' | relative_url }}" alt="Tallinn University" width="180" height="58"
            ><span>School of Digital Technologies</span></a
          >
          <a href="https://edtechtalents.eu/"
            ><img src="{{ '/assets/img/brands/edtech-talents.png' | relative_url }}" alt="EdTech Talents" width="176" height="58"
            ><span>Academia–industry collaboration</span></a
          >
          <a class="mathearena-brand" href="{{ '/work/mathearena-estonia/' | relative_url }}"
            ><img src="{{ '/assets/img/brands/mathearena.png' | relative_url }}" alt="" width="48" height="48"><strong>MatheArena</strong
            ><span>Estonian localisation · in development</span></a
          >
        </div>
        <div class="profile-links">
          {% for p in site.data.profiles -%}
            {%- unless p.title == 'Tallinn University' -%}
              <a href="{{ p.url }}">
                {{- p.title }}
                <span aria-hidden="true">↗</span></a
              >
            {%- endunless -%}
          {%- endfor %}
        </div>
        <div class="footer-bottom">
          <span>© {{ 'now' | date: '%Y' }} Mart Laanpere</span
          ><span>Built with <a href="https://github.com/alshedivat/al-folio">al-folio</a> · Hosted on GitHub Pages</span
          ><span>EN / <a href="{{ '/et/' | relative_url }}" lang="et">ET</a></span>
        </div>
      </div>
    </footer>
  </body>
</html>
